# Mal for lokale miljøvariabler. Kopier til .env og fyll inn lokalt. Aldri ekte verdier her.
# I produksjon kommer alt fra Scaleway Secret Manager.

# Database
ConnectionStrings__Vasko=Host=localhost;Port=5432;Database=vasko;Username=vasko;Password=

# Kryptering av dørkoder og adresser (base64, 32 byte)
Vasko__Kryptering__Nokkel=

# Vipps (test-miljø lokalt)
Vipps__BaseUrl=https://apitest.vipps.no
Vipps__ClientId=
Vipps__ClientSecret=
Vipps__SubscriptionKey=
Vipps__MerchantSerialNumber=
Vipps__CallbackAuthToken=

# Sveve SMS
Sveve__Brukernavn=
Sveve__Passord=
Sveve__Avsender=Vasko

# Push (APNs / FCM, se ADR 0003)
Push__Apns__KeyId=
Push__Apns__TeamId=
Push__Fcm__ProjectId=

# Plausible
Plausible__Domene=

# App (Expo): kun offentlige verdier, alt med EXPO_PUBLIC_ havner i app-bundelen
EXPO_PUBLIC_API_URL=http://localhost:5197
